# Sanad Elec - Environment Configuration
# Add these in Vercel Project Settings > Environment Variables for maximum security

# Admin credentials
ADMIN_EMAIL=admin@sanadelec.ma
ADMIN_PASSWORD=change_this_to_a_strong_password

# Secret key used for signing administrative session cookies
ADMIN_SESSION_SECRET=create_a_random_long_secret_here

# Default WhatsApp number for customer orders (country code without '+')
WHATSAPP_NUMBER=212600000000
